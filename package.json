{
  "name": "yfm3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun install && npm-run-all2 --parallel dev:backend dev:frontend",
    "dev:backend": "convex dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:bridge": "vitest run --config vitest.bridge.config.ts",
    "test:dom": "vitest run --config vitest.dom.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:watch": "vitest",
    "lint": "biome check . --fix",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b",
    "gen:ref": "bun run scripts/generate-fixtures.ts",
    "verify:rp": "bun run scripts/verify-game-data.ts 'gamedata/rp-bin/Yu-Gi-Oh! FM REMASTERED PERFECTED.bin' tests/data/rp",
    "verify:vanilla": "bun run scripts/verify-game-data.ts 'gamedata/vanilla-bin/Yu-Gi-Oh! Forbidden Memories (France).bin' tests/data/vanilla",
    "extract:rp": "bun run scripts/extract-game-data.ts 'gamedata/rp-bin/Yu-Gi-Oh! FM REMASTERED PERFECTED.bin' public/data/rp",
    "extract:vanilla": "bun run scripts/extract-game-data.ts 'gamedata/vanilla-bin/Yu-Gi-Oh! Forbidden Memories (France).bin' public/data/vanilla",
    "decomp:loop": "bun run decomp/scripts/decomp-state.ts",
    "decomp:state": "bun run decomp/scripts/decomp-state.ts",
    "decomp:verify-map": "bun run decomp/scripts/decomp-verify-map.ts",
    "decomp:verify-unit": "bun run decomp/scripts/decomp-verify-unit.ts",
    "decomp:verify-linked-unit": "bun run decomp/scripts/decomp-verify-linked-unit.ts",
    "decomp:verify-linked-manifest": "bun run decomp/scripts/decomp-verify-linked-manifest.ts",
    "decomp:build-manual-disc": "bun run decomp/scripts/decomp-build-manual-disc.ts",
    "decomp:rebuild-exe": "bun run decomp/scripts/decomp-rebuild-exe.ts",
    "decomp:slice-asm": "bun run decomp/scripts/decomp-extract-asm-block.ts",
    "build:vanilla-ref": "bun run scripts/build-vanilla-reference.ts",
    "bridge": "bun bridge/watch.ts",
    "bridge:build": "bash scripts/build-bridge-zip.sh",
    "bridge:bump": "cd bridge && npm version patch && npm install",
    "deploy": "convex deploy --cmd 'bun run build' --cmd-url-env-var-name VITE_CONVEX_URL && convex run migrations:runAll",
    "release:bridge": "TAG=bridge-v$(node -p \"require('./bridge/package.json').version\") && git tag $TAG && git push origin $TAG",
    "prepare": "husky",
    "loc": "find . -type f \\( -name '*.ts' -o -name '*.tsx' \\) -not -path '*/node_modules/*' -not -path './.git/*' -not -path './dist/*' | xargs wc -l | tail -1",
    "upgr": "bun upgrade && bun update --interactive"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@clerk/clerk-react": "^5.61.3",
    "@convex-dev/aggregate": "0.2.1",
    "@convex-dev/migrations": "^0.3.5",
    "@fontsource/cinzel": "^5.2.8",
    "@formkit/auto-animate": "^0.9.0",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "convex": "^1.39.1",
    "jotai": "^2.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
